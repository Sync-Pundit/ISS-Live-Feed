{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "iss-live-feed",
	"main": "./src/worker.js",
	"compatibility_date": "2026-06-20",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*"]
	},
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	},
	"vars": {
		"YOUTUBE_CHANNEL_IDS": "UCLA_DiR1FfKNvjuUpBHmylQ",
		"YOUTUBE_FALLBACK_TITLE": "ISS video from NASA",
		"STREAM_CACHE_SECONDS": "10800"
	}
}
