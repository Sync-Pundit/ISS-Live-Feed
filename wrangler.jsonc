{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "iss-live-feed",
	"main": "./src/worker.js",
	"compatibility_date": "2026-06-20",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*"]
	},
	"kv_namespaces": [
		{
			"binding": "STREAM_STATE",
			"id": "d1d9539494aa46d398a0931ed7afde2e"
		}
	],
	"triggers": {
		"crons": ["0,30 * * * *"]
	},
	"observability": {
		"enabled": true,
		"redact_query_string": true,
		"logs": {
			"enabled": true,
			"invocation_logs": true,
			"persist": true,
			"head_sampling_rate": 1
		},
		"traces": {
			"enabled": true,
			"persist": true,
			"head_sampling_rate": 0.05
		}
	}
}
